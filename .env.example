# FlowForge AI - Environment Configuration
# Copy to .env and fill in real values

# NVIDIA Build API (OpenAI-compatible)
NVIDIA_BUILD_API_KEY=nvapi-your-key-here
NVIDIA_BUILD_BASE_URL=https://integrate.api.nvidia.com/v1

# Server
HOST=0.0.0.0
PORT=8080

# Database
DATABASE_URL=sqlite:///data/flowforge.db

# Auth (demo token, replace in production)
AUTH_TOKEN=flowforge-demo-token

# Artifacts
ARTIFACTS_DIR=artifacts
# Model Selection (M15)
LOCAL_CACHE_PATH=D:\HuggingFaceCache
OFFICIAL_MODEL_SPECIFIED=false
OFFICIAL_MODEL_ID=
SELECTION_RATIONALE=
FALLBACK_MODEL_ID=nvidia/nemotron-3-super-120b-a12b
UPGRADE_ROLLBACK_PATH=data/model_upgrade_rollbacks
# Claude Opus 5 (via openai-next.com gateway) - 重做过程专用，不入提交包
CLAUDE_OPUS5_KEY=your_claude_opus5_key_here  # 仅重做过程使用，不入提交包